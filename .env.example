APP_NAME="Benin Petro - Gestion de Flotte"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=benin_petro_flotte
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# En recette, "log" ecrit les e-mails dans storage/logs/laravel.log :
# aucun serveur SMTP n'est necessaire pour tester la plateforme.
# En production, basculer sur "smtp" et renseigner l'hote reel.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="flotte@beninpetro.bj"
MAIL_FROM_NAME="${APP_NAME}"

# --- Cles API (modifiables aussi depuis Parametres > Integrations dans l'application) ---
GOOGLE_MAPS_API_KEY=
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=BENINPETRO
